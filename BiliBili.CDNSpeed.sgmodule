#!name = 📺 BiliBili: ⚡ CDN Speed
#!desc = 自动测速并把 B 站视频流重定向到最快的 CDN（替代 Biliverse Redirect，请勿同时启用）
#!category = 🪐 Biliverse
#!homepage = https://github.com/OctoLeft/bili-cdn-speed
#!arguments = Fallback:"upos-sz-mirrorcosov.bilivideo.com",Cron:"*/30 * * * *",MaxAge:"120",TopN:"5",SampleKB:"2048",Notify:"false",InlineRace:"true",RewriteMainland:"true",Candidates:""
#!arguments-desc = Fallback: 还没有测速结果时使用的主机名\n\nCron: 后台测速频率（cron 表达式）\n\nMaxAge: 结果超过多少分钟算过期；过期后播放时会用当前视频快速竞速一次（Apple TV 主要靠这个）\n\nTopN: 吞吐测试测延迟最低的前几名\n\nSampleKB: 吞吐测试每个主机下载多少 KB\n\nNotify: 后台测速完成后是否发通知 (true/false)\n\nInlineRace: 结果过期时是否在播放时竞速 (true/false)\n\nRewriteMainland: 是否也接管大陆 upos-sz-mirror* 主机 (true/false)\n\nCandidates: 自定义候选主机，用 | 分隔；留空使用内置 15 个

[General]
force-http-engine-hosts = %APPEND% upos-sz-mirror*.bilivideo.com:80, cn-hk-eq-*.bilivideo.com:80, upos-*-mirrorakam.akamaized.net:80, *:4480, *:4483, *:9102

[Script]
BiliCDN.Redirect.upos = type=http-request, pattern=^https?:\/\/(upos-[a-z0-9-]*mirror[a-z0-9-]*\.bilivideo\.com|cn-hk-eq-[a-z0-9-]+\.bilivideo\.com|upos-(sz|hz|bstar1)-mirrorakam\.akamaized\.net)(:\d+)?\/upgcxcode\/, script-path=https://raw.githubusercontent.com/OctoLeft/bili-cdn-speed/main/bili-cdn-redirect.js, timeout=10, argument="Fallback={{{Fallback}}}&MaxAge={{{MaxAge}}}&InlineRace={{{InlineRace}}}&RewriteMainland={{{RewriteMainland}}}&Candidates={{{Candidates}}}"
BiliCDN.Redirect.mcdn = type=http-request, pattern=^https?:\/\/[a-z0-9]+\.mcdn\.bilivideo\.cn(:\d+)?\/upgcxcode\/, script-path=https://raw.githubusercontent.com/OctoLeft/bili-cdn-speed/main/bili-cdn-redirect.js, timeout=10, argument="Fallback={{{Fallback}}}&MaxAge={{{MaxAge}}}&InlineRace={{{InlineRace}}}&RewriteMainland={{{RewriteMainland}}}&Candidates={{{Candidates}}}"
BiliCDN.Redirect.pcdn = type=http-request, pattern=^https?:\/\/[^/]+:4480\/upgcxcode\/, script-path=https://raw.githubusercontent.com/OctoLeft/bili-cdn-speed/main/bili-cdn-redirect.js, timeout=10, argument="Fallback={{{Fallback}}}&MaxAge={{{MaxAge}}}&InlineRace={{{InlineRace}}}&RewriteMainland={{{RewriteMainland}}}&Candidates={{{Candidates}}}"
BiliCDN.SpeedTest = type=cron, cronexp="{{{Cron}}}", wake-system=0, timeout=90, script-path=https://raw.githubusercontent.com/OctoLeft/bili-cdn-speed/main/bili-cdn-speedtest.js, argument="TopN={{{TopN}}}&SampleKB={{{SampleKB}}}&Notify={{{Notify}}}&Candidates={{{Candidates}}}"
BiliCDN.Panel = type=generic, timeout=90, script-path=https://raw.githubusercontent.com/OctoLeft/bili-cdn-speed/main/bili-cdn-speedtest.js, argument="TopN={{{TopN}}}&SampleKB={{{SampleKB}}}&Notify=false&Candidates={{{Candidates}}}"

[Panel]
BiliCDN.Panel = script-name=BiliCDN.Panel, update-interval=600

[MITM]
hostname = %APPEND% upos-*mirror*.bilivideo.com, cn-hk-eq-*.bilivideo.com, upos-*-mirrorakam.akamaized.net, *.mcdn.bilivideo.cn, upos-*mirror*.bilivideo.com:4483, cn-hk-eq-*.bilivideo.com:4483, upos-*-mirrorakam.akamaized.net:4483, *.mcdn.bilivideo.cn:4483
